# Copy this file to `.env` (or `debo.env`) in the repository you inspect.
# Values already present in the process environment are never overwritten.

# --- GitLab -------------------------------------------------------------
# Required by code_review_context and by jenkins_status without a build_url.
GITLAB_API_URL=https://gitlab.example/api/v4
GITLAB_TOKEN=

# Usernames whose merge request notes are never treated as review comments,
# such as CI service accounts. Comma separated, optional.
GITLAB_IGNORED_REVIEW_AUTHORS=

# Project used for commit status lookups. Defaults to the `origin` remote path,
# set it to a numeric project ID when that path is not addressable. Optional.
GITLAB_PROJECT_ID=

# --- Jenkins ------------------------------------------------------------
JENKINS_URL=https://jenkins.example
JENKINS_USER=
JENKINS_API_TOKEN=

# Name of the GitLab commit status carrying the build URL. Defaults to "build".
JENKINS_BUILD_STATUS_NAME=

# --- Jira ---------------------------------------------------------------
JIRA_URL=https://jira.example
JIRA_API_TOKEN=

# REST and browse prefixes below JIRA_URL. Default to "rest/api/2" and "browse".
JIRA_API_PATH=
JIRA_BROWSE_PATH=

# Session cookie, only needed when Jira sits behind an SSO proxy. Optional.
JIRA_COOKIE=

# Directory image attachments are written to. Defaults to "ticket-analysis".
JIRA_ATTACHMENT_DIR=

# Display names for status IDs the instance does not resolve, as `id=Name`
# pairs. Optional.
JIRA_STATUS_NAMES=

# --- SonarQube ----------------------------------------------------------
SONAR_HOST_URL=https://sonar.example
SONAR_TOKEN=
SONAR_PROJECT_KEY=

# Prefix added to branch names that lack it. Defaults to "origin/", set it to
# "-" to disable prefixing. Optional.
SONAR_BRANCH_PREFIX=

# --- Runtime ------------------------------------------------------------
# Default worktree to inspect when commands omit --worktree or MCP calls omit
# worktree_path. Optional.
DEBOAI_REPOSITORY_ROOT=

# Environment filenames to load in each applicable lookup directory, separated
# by ":". Defaults to ".env:debo.env".
DEBOAI_ENV_FILE=
